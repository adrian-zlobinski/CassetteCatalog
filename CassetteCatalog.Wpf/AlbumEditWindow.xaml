<Window x:Class="CassetteCatalog.Wpf.AlbumEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CassetteCatalog.Wpf"
        xmlns:conv="clr-namespace:CassetteCatalog.Wpf.Converters"
        xmlns:localEnums="clr-namespace:CassetteCatalog.Core.Enums;assembly=CassetteCatalog.Core"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="385" Width="760" WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize">
    <Window.Resources>
        <conv:TapeTypeToStringConverter x:Key="TapeTypeConverter"/>
        <conv:TimeSpanToStringConverter x:Key="TimeSpanConverter"/>
        <ObjectDataProvider x:Key="CassetteSides" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="localEnums:eCassetteSide"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <Style TargetType="TextBox" x:Key="TextBoxWithValidation">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self},
                        Path=(Validation.Errors)[0].ErrorContent}"/>
                    <Setter Property="Background" Value="#FFF0F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <!--Główny kontener  podzielony w pione na dwa. Na górze kontent, na dole przyciski do zapisu i anulowania-->
    <StackPanel Orientation="Vertical" Name="spMain">
        <!-- zawartość na dane-->
        <StackPanel Orientation="Horizontal" Name="spContent">
            <!--lewa strona z etykietami i polami tekstowymi-->
            <StackPanel Orientation="Vertical" Margin="5" Width="250">
                <Label Content="Artysta"/>
                <TextBox Text="{Binding Artist, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" Margin="0,0,0,10" Style="{StaticResource TextBoxWithValidation}"/>
                <Label Content="Tytuł:"/>
                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=True}" Margin="0,0,0,10" Style="{StaticResource TextBoxWithValidation}"/>
                <Label Content="Rok wydania:"/>
                <TextBox Text="{Binding ReleaseYear, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Margin="0,0,0,10" Style="{StaticResource TextBoxWithValidation}"/>
                <Label Content="Rodzaj taśmy"/>
                <ComboBox ItemsSource="{Binding TapeTypes}"
                  SelectedItem="{Binding SelectedTapeType}"
                  Margin="0,0,0,10">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource TapeTypeConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Label Content="Nazwa kasety"/>
                <TextBox Text="{Binding CassetteName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
            </StackPanel>
            <!--prawa strona z listą utworów i przyciskami operacji na utworach-->
            <StackPanel Orientation="Vertical" Margin="5">
                <DataGrid ItemsSource="{Binding Tracks}"
                          SelectedItem="{Binding SelectedTrack}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Height="240">
                    <DataGrid.Resources>
                        <Style x:Key="GridTextBlockWithValidation" TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Validation.HasError" Value="True">
                                    <Setter Property="Background" Value="Red"/>
                                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="GridTextBoxWithWalidation" TargetType="TextBox">
                            <Setter Property="Validation.ErrorTemplate">
                                <Setter.Value>
                                    <ControlTemplate>
                                        <Border BorderBrush="Red" BorderThickness="1">
                                            <AdornedElementPlaceholder/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nr" Width="40" Binding="{Binding Number}"/>
                        <DataGridTextColumn Header="Tytuł" 
                                            Width="300" 
                                            Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                            ElementStyle="{StaticResource GridTextBlockWithValidation}"/>
                        <DataGridTextColumn Header="Czas" 
                                            Width="60" 
                                            Binding="{Binding Duration, Converter={StaticResource TimeSpanConverter}, ValidatesOnDataErrors=True}"
                                            ElementStyle="{StaticResource GridTextBlockWithValidation}"/>
                        <DataGridComboBoxColumn Header="Strona" 
                                                ItemsSource="{Binding Source={StaticResource CassetteSides}}"
                                                SelectedItemBinding="{Binding Side, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                Width="50">
                            <DataGridComboBoxColumn.EditingElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="IsDropDownOpen" Value="True"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <Trigger Property="Validation.HasError" Value="True">
                                            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridComboBoxColumn.EditingElementStyle>
                        </DataGridComboBoxColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Orientation="Horizontal" Height="30">
                    <Label Content="Łączny czas:" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalDurationFormatted}" VerticalAlignment="Center" FontWeight="Bold" Margin="5,0,0,0"/>
                    <Label Content=" | Utworów:" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TrackCount}" VerticalAlignment="Center" FontWeight="Bold" Margin="5,0,0,0"/>
                    <Label Content="Czas strony A" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SideADurationFormatted}" VerticalAlignment="Center" FontWeight="Bold" Margin="5,0,0,0"/>
                    <Label Content="Czas strony B" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SideBDurationFormatted}" VerticalAlignment="Center" FontWeight="Bold" Margin="5,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Name="spTrackButtons" Margin="5">
                    <Button Content="➕ Dodaj utwór" Margin="0,0,10,0" Padding="2" Command="{Binding AddTrackCommand}"/>
                    <Button Content="➖ Usuń wybrany" Margin="0,0,10,0" Padding="2" Command="{Binding DeleteTrackCommand}" />
                    <Button Content="▲" ToolTip="Przesuń w górę" Margin="0,0,10,0" Padding="2" Command="{Binding MoveTrackUpCommand}"/>
                    <Button Content="▼" ToolTip="Przesuń w dół" Margin="0,0,10,0" Padding="2" Command="{Binding MoveTrackDownCommand}"/>
                    <Button Content="🗑️ Wyczyść" Padding="2" Command="{Binding DeleteAllTracksCommand}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <!-- przyciski zapisu i anulowania-->
        <StackPanel Orientation="Horizontal" Name="spButtons" HorizontalAlignment="Right" Margin="5">
            <Button Content="Zapisz" Width="80" Margin="0,0,10,0" Command="{Binding SaveCommand}"/>
            <Button Content="Anuluj" Width="80" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
